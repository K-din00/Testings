# Connection string for the API's least-privilege PostgreSQL role.
# The host `db` is the PostgreSQL service on the shared `postgres_database` network.
# Replace CHANGE_ME with the password created for the `signup_api` role.
DATABASE_URL=postgres://signup_api:CHANGE_ME@db:5432/myapp

# Set to true in production so session cookies are only sent over HTTPS.
COOKIE_SECURE=true
